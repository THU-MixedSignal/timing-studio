  parameter real vlow = 0.0;
  parameter real vhigh = 1.0 from (vlow:inf);
  parameter real trise = 200000e-15 from (0:inf);
  parameter real tfall = 200000e-15 from (0:inf);
  parameter real time_scale = 1.0 from (0:inf);
  parameter integer cycles = 0 from [0:1000000000]; // 0 = forever

